PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# REQUIRED, minimum 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   # or: openssl rand -hex 32
# The backend refuses to start if this is missing, short, or a known placeholder.
JWT_SECRET=
# PostgreSQL connection string. Must match the database you actually created.
# Generate a strong password:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Leave DATABASE_URL empty (or remove it) to fall back to a local SQLite file.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_A_STRONG_PASSWORD@localhost:5432/flowpilot_db
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Demo accounts (local development only) ────────────────────────────────────
# Both flags are required before the fixed-credential demo users are created.
# The seed is ALWAYS skipped when NODE_ENV=production, regardless of these.
ENABLE_DEMO_SEED=false
DEMO_USER_PASSWORD=
DEMO_USER_EMAIL=demo@flowpilot.test
DEMO_ADMIN_EMAIL=admin@flowpilot.test
DEMO_USER_NAME=Demo User
DEMO_ADMIN_NAME=Admin User

# ── Payments ─────────────────────────────────────────────────────────────────
# Every gateway is optional. Without keys the app still boots and the checkout
# endpoints answer with a clear "not configured" message instead of failing.
# Insert only the keys you want to sell with, then list them here:
#   PAYMENT_GATEWAYS_ENABLED=stripe,paypal,lemonsqueezy     (or =all for testing)
PAYMENT_GATEWAYS_ENABLED=stripe,paypal,lemonsqueezy
DEFAULT_CURRENCY=USD
FRONTEND_URL=http://localhost:5173

# Stripe — dashboard.stripe.com/apikeys  (webhook: /api/payment/webhook)
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal — developer.paypal.com/dashboard/applications  (webhook: /api/payment/paypal/webhook)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Lemon Squeezy (merchant of record) — app.lemonsqueezy.com/settings/api
# Overlay checkout only needs the store id; an API key additionally enables
# server-side checkout creation. Webhook: /api/lemonsqueezy/webhook
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STORE_URL=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID=
# One variant per pricing tier — LEMONSQUEEZY_VARIANT_STARTER / _PRO / _ENTERPRISE
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_ENTERPRISE=

# Paddle (merchant of record) — webhooks: /api/payment/paddle/webhook
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox

# Additional gateways — enable them with PAYMENT_GATEWAYS_ENABLED=all
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
MOLLIE_API_KEY=
MOLLIE_ORGANIZATION_ID=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_PASSWORD=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CHANNEL_ID=WEB
PAYTM_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_MERCHANT_ID=
